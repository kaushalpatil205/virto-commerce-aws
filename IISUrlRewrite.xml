<?xml version="1.0" encoding="utf-8"?>
<rewrite>
    <rules>
        <rule name="GraphQL Proxy Route" stopProcessing="true">
            <match url="^graphql" />
            <action type="Rewrite" url="/xapi/graphql" />
        </rule>
        <rule name="SPA Fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
                <add input="{REQUEST_URI}" pattern="^/(api|xapi|graphql|assets|cms-content|static|favicon\.ico|remoteEntry.*\.js)" negate="true" />
                <add input="{REQUEST_URI}" pattern="\.(js|css|png|jpg|jpeg|gif|ico|svg|json|woff|woff2|ttf|eot|webmanifest|map)$" negate="true" />
            </conditions>
            <action type="Rewrite" url="/" />
        </rule>
    </rules>
</rewrite>